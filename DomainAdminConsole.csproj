<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DomainAdminConsole</AssemblyName>
    <RootNamespace>DomainAdminConsole</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Authors>BasiliyWolf</Authors>
    <Company>BasiliyWolf</Company>
    <Product>Domain Admin Console</Product>
    <Description>Windows domain administration console</Description>
    <Copyright>Copyright © 2026 BasiliyWolf</Copyright>
    <Version>0.3.8</Version>
    <FileVersion>0.3.8.0</FileVersion>
    <AssemblyVersion>0.3.8.0</AssemblyVersion>
  </PropertyGroup>

<ItemGroup>
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.4.15" />
    <PackageReference Include="System.DirectoryServices" Version="8.0.1" />
  </ItemGroup>
</Project>
